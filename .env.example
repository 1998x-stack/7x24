# News24 V1.1 supported local runtime. Never commit real credentials.
NEWS24_DATA_DIR=./data

# Optional, only for explicitly queued AI work (install the llm extra first).
NEWS24_ANALYSIS_MODEL=
OPENAI_API_KEY=
# Leave empty for the provider default endpoint unless a compatible proxy is reviewed.
OPENAI_BASE_URL=

# Optional, local-workbench operator mode. Blank = read-only.
# Generate a long random token locally; never put a real secret in Git.
NEWS24_REVIEW_TOKEN=
NEWS24_REVIEWER=local-operator
