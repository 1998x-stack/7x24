# Legacy pipeline only; not News24 V1.1 core
NEWS24_DATA_DIR=./data

# Historical legacy.src.main entrypoint settings
SINA_BASE_URL=https://zhibo.sina.com.cn/api
SINA_ZHIBO_ID=152
SINA_DELAY=0.5
SINA_TIMEOUT=15
REQUEST_TIMEOUT=30
DATA_DIR=./data
REPORT_OUTPUT_DIR=./reports
LOG_DIR=./logs
COLLECTION_INTERVAL_MINUTES=30
DAILY_REPORT_HOUR=8
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30

# Optional model and graph services for legacy experiments
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# V0.5 intentionally requires an explicit model choice for AI analysis
NEWS24_ANALYSIS_MODEL=
OPENAI_MODEL=gpt-4-turbo
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
